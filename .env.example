# 複製成 .env 後填入（.env 不會進 git）
# Gemini API key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 模型；可用 python -m app.agent --list-models 查詢
# 免費額度每個模型分開算：Agent 用 GEMINI_MODEL（忙碌時改用 FALLBACK），護欄用 GUARD
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite
# 輸出護欄是否再用 LLM 檢查（1 開 / 0 關，關掉可省額度）
OUTPUT_GUARD_LLM=1

# LINE Developers → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
