# 複製成 .env 後填入（.env 不會進 git）
# Gemini API key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 模型；可用 python -m app.agent --list-models 查詢
# 免費額度每個模型分開算（每分鐘、每天各有上限）：Agent 用 GEMINI_MODEL，額度用完依序改用 FALLBACK（逗號分隔）；護欄用 GUARD
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_GUARD_FALLBACK_MODEL=gemini-2.5-flash-lite,gemini-3.1-flash-lite
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite
# 輸出護欄是否再用 LLM 檢查（1 開 / 0 關，關掉可省額度）
OUTPUT_GUARD_LLM=1

# 每天幾點自動更新標案與補助（服務需開著）
DAILY_UPDATE_TIME=07:30
